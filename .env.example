# ==============================================================================
# Lyftr AI LLM Chatbot - Environment Configuration (.env.example)
# ==============================================================================

# Comma-separated key pool (at least 2 keys).
# Mapped in order as: key_1, key_2, ...
# For Gemini: generate API keys from Google AI Studio (https://aistudio.google.com/)
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# SQLite database URL.
# In Docker, use sqlite:////data/app.db (mounted to named volume).
# Locally without Docker, use sqlite:///./app.db
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS allowed origins. Use * or specific origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables the X-Simulate-Failure request header hook for testing failover (true/false)
ENABLE_FAILURE_SIMULATION=true

# LiteLLM model identifier (default: gemini/gemini-2.0-flash)
DEFAULT_MODEL=gemini/gemini-2.0-flash

# Default fallback system prompt when not provided in request
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# Frontend backend connection URL (used during build or local dev)
VITE_BACKEND_URL=http://localhost:8000
